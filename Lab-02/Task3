<?php

//Task3
abstract class Vehicle{
    abstract public function start();
}

class Car extends Vehicle{
    public function start()
    {
        echo "Car engine started.";
    }
}

class Bike extends Vehicle{
    public function start()
    {
        echo "Bike started.";
    }
}

$car = new Car();
$bike = new Bike();

$car->start();
echo "<br>";

$bike->start();
?>
